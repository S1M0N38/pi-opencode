{
  "name": "@s1m0n38/pi-opencode",
  "version": "1.5.3",
  "description": "Rotate between multiple OpenCode Go API keys with reactive 429, rate-limit, and watchdog stall detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S1M0N38/pi-opencode.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "opencode",
    "api-key-rotation",
    "rate-limit"
  ],
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typescript": "7.0.2"
  }
}
